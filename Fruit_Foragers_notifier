-- ========== HELPERS ==========
local function ColorToHex(color)
    return string.format("%02X%02X%02X", math.clamp(color.R*255,0,255), math.clamp(color.G*255,0,255), math.clamp(color.B*255,0,255))
end

local function ColorRarityOnce(name, rarity, hex)
    local s,e = string.find(name, rarity, 1, true)
    if not s then return name end
    return string.sub(name,1,s-1) .. "<font color='#"..hex.."'>"..rarity.."</font>" .. string.sub(name,e+1)
end

local function GetTeleportPart(tool)
    if not tool then return nil end
    if tool:FindFirstChild("Handle") and tool.Handle:IsA("BasePart") and tool.Handle.Transparency < 1 then
        return tool.Handle
    end
    for _,v in ipairs(tool:GetDescendants()) do
        if v:IsA("BasePart") and v.Transparency < 1 then return v end
    end
    return nil
end

-- create/remove highlight (ESP visible through walls)
local function removeHighlight(tool)
    if not tool then return end
    local key = tostring(tool:GetDebugId())
    if currentHighlights[key] then
        pcall(function() currentHighlights[key]:Destroy() end)
        currentHighlights[key] = nil
    end
end

local function createHighlight(tool)
    if not tool then return end
    local key = tostring(tool:GetDebugId())
    removeHighlight(tool)
    local part = GetTeleportPart(tool) or tool
    if not part then return end
    if not ESP_ENABLED then return end
    local h = Instance.new("Highlight")
    h.Name = "NotifHighlight_"..(tool.Name:gsub("%s","_"))
    h.Adornee = part
    h.FillColor = rarityColors["[EPIC]"]
    h.OutlineColor = Color3.new(0,0,0)
    h.Parent = workspace
    for tag,_ in pairs(rarityColors) do
        if tool.Name:find(tag) then
            h.FillColor = rarityColors[tag]
            break
        end
    end
    h.FillTransparency = 0.6
    h.OutlineTransparency = 0
    currentHighlights[key] = h
end

-- ================= FIXED: Only highlight selected rarities =================
local function updateToolHighlightState(tool)
    if not tool or not tool:IsA("Tool") then return end
    local found = nil
    for _,tag in ipairs(RARITY_ORDER) do
        if tool.Name:find(tag, 1, true) then
            found = tag
            break
        end
    end
    -- Only highlight if ESP is on AND rarity is enabled
    if ESP_ENABLED and found and rarityEnabled[found] then
        createHighlight(tool)
    else
        removeHighlight(tool)
    end
end

local function refreshESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") then
            updateToolHighlightState(obj)
        end
    end
end
