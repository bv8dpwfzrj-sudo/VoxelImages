-- ========== NOTIFICATION SYSTEM ==========
local function UpdateStack()
    for i, frame in ipairs(notifications) do
        if frame.Parent then
            local finalY = 50 + (i-1)*90
            TweenService:Create(frame, TweenInfo.new(0.25), {Position = UDim2.new(0.5, -175, 0, finalY)}):Play()
        end
    end
end

local function createNotification(tool)
    if not tool or notified[tool] then return end
    local found = nil
    for _, tag in ipairs(RARITY_ORDER) do
        if tool.Name:find(tag, 1, true) then found = tag break end
    end
    if not found then return end
    if not rarityEnabled[found] then return end

    notified[tool] = true
    updateToolHighlightState(tool)

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0,350,0,80)
    frame.Position = UDim2.new(0.5, -175, 0, -80)
    frame.BackgroundColor3 = Color3.fromRGB(30,30,30)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Parent = screenGui
    Instance.new("UICorner", frame)

    local viewport = Instance.new("ViewportFrame")
    viewport.Size = UDim2.new(0,80,1,0)
    viewport.Position = UDim2.new(0,0,0,0)
    viewport.BackgroundTransparency = 1
    viewport.Parent = frame

    local part = GetTeleportPart(tool)
    if part then
        local clone = part:Clone()
        clone.Parent = viewport
        clone.Position = Vector3.new(0,0,0)
        local cam = Instance.new("Camera")
        cam.Parent = viewport
        viewport.CurrentCamera = cam
        cam.CFrame = CFrame.new(clone.Position + Vector3.new(3,3,3), clone.Position)
    end

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -90, 1, 0)
    button.Position = UDim2.new(0,90,0,0)
    button.BackgroundTransparency = 1
    button.RichText = true
    button.Font = Enum.Font.GothamBold
    button.TextScaled = true
    button.TextColor3 = Color3.new(1,1,1)
    button.Parent = frame

    local esc = tool.Name:gsub("<","&lt;"):gsub(">","&gt;")
    local hex = ColorToHex(rarityColors[found] or Color3.new(1,1,1))
    button.Text = "A "..ColorRarityOnce(esc, found, hex).." has spawned!"

    viewport.MouseEnter:Connect(function()
        TweenService:Create(viewport, TweenInfo.new(0.15), {Size = UDim2.new(0,92,1,0)}):Play()
    end)
    viewport.MouseLeave:Connect(function()
        TweenService:Create(viewport, TweenInfo.new(0.15), {Size = UDim2.new(0,80,1,0)}):Play()
    end)

    button.MouseButton1Click:Connect(function()
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local tp = GetTeleportPart(tool)
        if hrp and tp then hrp.CFrame = CFrame.new(tp.Position + Vector3.new(0,10,0)) end
    end)

    table.insert(notifications, frame)
    UpdateStack()

    task.delay(NOTIF_LIFETIME, function()
        if frame and frame.Parent then
            TweenService:Create(frame, TweenInfo.new(0.25), {Position = UDim2.new(0.5,-175,0,-120)}):Play()
            task.wait(0.25)
            if frame and frame.Parent then frame:Destroy() end
            removeHighlight(tool)
            for i,v in ipairs(notifications) do if v==frame then table.remove(notifications,i) break end end
            UpdateStack()
        end
    end)

    tool.AncestryChanged:Connect(function(_, parent)
        if parent ~= workspace and frame.Parent then
            button.Text = "<font color='#FF0000'>COLLECTED</font>"
            task.delay(2, function()
                if frame and frame.Parent then
                    TweenService:Create(frame, TweenInfo.new(0.25), {Position = UDim2.new(0.5,-175,0,-120)}):Play()
                    task.wait(0.25)
                    if frame and frame.Parent then frame:Destroy() end
                    removeHighlight(tool)
                    for i,v in ipairs(notifications) do if v==frame then table.remove(notifications,i) break end end
                    UpdateStack()
                end
            end)
        end
    end)
end

